{
  "name": "icon-desk-drawer",
  "version": "1.3.1",
  "description": "A lightweight drag-and-drop Windows desktop launcher.",
  "main": "src/main.js",
  "author": "Coastal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coastal-ms/icondeskdrawer.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.coastal.icondeskdrawer",
    "productName": "Icon Desk Drawer",
    "artifactName": "IconDeskDrawer-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "coastal-ms",
        "repo": "icondeskdrawer",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
